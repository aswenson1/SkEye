(fp_line (start -1.7 3.15) (end 1.7 3.15) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(fp_line (start -3.15 -0.7) (end -3.15 0.7) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(fp_line (start 3.15 -0.7) (end 3.15 0.7) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(pad "1" thru_hole circle (at -3.25 -2.25) (size 2 2) (drill 1.0) (layers "*.Cu" "*.Mask"))
(pad "1" thru_hole circle (at 3.25 -2.25) (size 2 2) (drill 1.0) (layers "*.Cu" "*.Mask"))
(pad "2" thru_hole circle (at -3.25 2.25) (size 2 2) (drill 1.0) (layers "*.Cu" "*.Mask"))
